@namespace GolfSG.Admin.Components
<div class="reset-wrap">
    <a class="back-link" href="/users">← Back to users</a>
    <p class="eyebrow">ACCOUNT SECURITY</p><h1>Reset user password</h1>
    @if (IsPreview) { <p class="preview-banner">LOCAL PREVIEW · SAMPLE ACCOUNT · No password will be changed.</p> }
    @if (Success) { <section role="status"><h2>@(IsPreview ? "Preview complete" : "Password reset completed")</h2><p>@(IsPreview ? "This was a demonstration. No account or session was changed." : "The password has been replaced and existing app sessions have been revoked. The account’s lockout status is unchanged.")</p><a class="button" href="/users">Return to users</a></section> }
    else if (Error is not null) { <section role="alert"><h2>Reset unavailable</h2><p>@Error</p>@if (!IsPreview) { <a class="button" href="@($"/password-reset-sign-in?id={Uri.EscapeDataString(UserId)}")">Sign in again</a> }</section> }
    else
    {
        <p class="intro">Set a new password for <strong>@Username</strong>. This signs the user out of existing app sessions.</p>
        <section><dl><dt>Username</dt><dd>@Username</dd><dt>Account ID</dt><dd><code>@UserId</code></dd></dl>
        <form method="post" action="@($"/users/{Uri.EscapeDataString(UserId)}/reset-password/submit")" class="reset-form">
            @if (!IsPreview) { <AntiforgeryToken /> }
            <label for="confirmUsername">Type the username to confirm</label><input id="confirmUsername" name="confirmUsername" required maxlength="50" autocomplete="off" />
            <label for="newPassword">New password</label><input id="newPassword" name="newPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password" disabled="@IsPreview" aria-describedby="password-help" />
            <label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password" disabled="@IsPreview" />
            <p id="password-help">12–128 characters, including uppercase, lowercase, a number and a symbol. Never paste a real password into the preview.</p>
            <label class="confirmation"><input type="checkbox" name="confirmed" value="true" required /> I confirm this password reset and the revocation of existing sessions.</label>
            <div class="reset-actions"><button type="submit">@(IsPreview ? "Preview password reset" : "Reset password and revoke sessions")</button><a class="button" href="/users">Cancel</a></div>
        </form></section>
        <p class="footnote">This action does not send an email or unlock a locked account. Communicate the replacement password through your approved private channel. Users are not automatically forced to change it on their next login.</p>
    }
</div>
@code {
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string Username { get; set; } = "";
    [Parameter] public bool IsPreview { get; set; }
    [Parameter] public bool Success { get; set; }
    [Parameter] public string? Error { get; set; }
}
