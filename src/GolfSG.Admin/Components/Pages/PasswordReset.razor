@page "/users/{UserId}/reset-password"
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authentication
@using GolfSG.Application.Server
@using Microsoft.Extensions.Caching.Memory
@inject IHttpContextAccessor Context
@inject IHttpClientFactory Clients
@inject IMemoryCache Cache
@inject IConfiguration Configuration
<PageTitle>GolfSG Admin · Reset password</PageTitle>
<PasswordResetView UserId="@UserId" Username="@username" Error="@error" Success="success" />
@code {
    [Parameter] public string UserId { get; set; } = "";
    private string username = "";
    private string? error;
    private bool success;
    protected override async Task OnInitializedAsync()
    {
        var context = Context.HttpContext!;
        var receipt = context.Request.Query["receipt"].ToString();
        if (receipt.Length > 0)
        {
            if (receipt.Length == 64 && Cache.TryGetValue<PasswordResetOutcome>("password-reset-" + receipt, out var outcome) &&
                outcome?.AccountId == UserId && outcome.ActorId == context.User.FindFirst(GolfSG.Security.AdminAccess.SubjectClaim(Configuration))?.Value)
            { Cache.Remove("password-reset-" + receipt); success = true; return; }
            error = "The confirmation has expired. A password reset may already have completed; verify the account before repeating it."; return;
        }
        if (context.Request.Query["result"] == "failed") { error = "The reset was not confirmed. Check permissions, recent sign-in, username and password requirements. If the connection was interrupted, the password may already have changed; verify before repeating."; return; }
        if (UserId.Length > 128) { error = "Invalid account."; return; }
        var token = await context.GetTokenAsync("access_token");
        if (string.IsNullOrEmpty(token)) { error = "Sign in again to reset a password."; return; }
        try
        {
            var client = Clients.CreateClient("AdminApi");
            using var access = new HttpRequestMessage(HttpMethod.Get, "api/admin/password-resets/access");
            access.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var permission = await client.SendAsync(access, context.RequestAborted);
            if (!permission.IsSuccessStatusCode) { error = "This action requires password-reset permission and a fresh administrator sign-in within the last five minutes."; return; }
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/admin/directory/users?search={Uri.EscapeDataString(UserId)}&limit=100");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.SendAsync(request, context.RequestAborted);
            var page = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<AdminDirectoryPage>(context.RequestAborted) : null;
            var account = page?.Items.SingleOrDefault(row => row.Id == UserId);
            if (account is null) error = "Account not found or access denied.";
            else username = account.Name;
        }
        catch (HttpRequestException) { error = "The API is unavailable. No password has been changed."; }
        catch (OperationCanceledException) when (!context.RequestAborted.IsCancellationRequested) { error = "The request timed out."; }
    }
}
